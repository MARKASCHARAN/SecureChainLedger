# ==============================================================================
# SecureChainLedger — Environment Variables
# Copy this file to .env and fill in your values. Never commit .env to git.
# ==============================================================================

# --- Application ---
NODE_ENV=development
APP_PORT=4000
APP_SECRET=your_jwt_secret_here
FRONTEND_URL=http://localhost:3000

# --- PostgreSQL ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=securechain
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_postgres_password

# --- Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- RabbitMQ ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672

# --- Hyperledger Fabric ---
FABRIC_CHANNEL_NAME=pharma-channel
FABRIC_CHAINCODE_NAME=securechain-cc
FABRIC_MSP_ID=Org1MSP
FABRIC_PEER_ENDPOINT=grpc://localhost:7051
FABRIC_ORDERER_ENDPOINT=grpc://localhost:7050
FABRIC_WALLET_PATH=./blockchain/network/wallets
FABRIC_CONNECTION_PROFILE=./blockchain/network/connection-profile.json

# --- AI Service ---
AI_SERVICE_URL=http://localhost:8000
AI_API_KEY=your_ai_service_key

# --- Monitoring ---
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
GRAFANA_ADMIN_PASSWORD=your_grafana_password

# --- Storage (IPFS / S3) ---
STORAGE_PROVIDER=ipfs
IPFS_API_URL=http://localhost:5001
AWS_S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=ap-south-1
